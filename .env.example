# ---- Supabase ----
# Project settings -> API. Safe to expose: used by the facilitator client with RLS on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix this NEXT_PUBLIC_ — that compiles it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Used to build QR codes and join links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
